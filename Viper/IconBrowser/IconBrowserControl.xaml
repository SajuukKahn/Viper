<UserControl
    x:Class="Viper.IconBrowser.IconBrowserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Viper.IconBrowser"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:virt="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    xmlns:vsfx="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
    Name="IconBrowser"
    Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
    Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}">
    <UserControl.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsfx:VsBrushes.ScreenTipBackgroundKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsfx:VsBrushes.ScreenTipTextKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsfx:VsBrushes.ScreenTipBorderKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="True" />
        </Style>

        <Style x:Key="MarkerBrushPathStyle" TargetType="Path">
            <Setter Property="Fill" Value="{DynamicResource {x:Static vsfx:VsBrushes.ControlLinkTextPressedKey}}" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <local:CaseInsensitiveStringCompareConverter x:Key="StringsAreEqualToTrue" />
        <local:NotNullToVisibleConverter x:Key="NotNullToVisible" />

        <Style x:Key="CompoundIconBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding SubIcon, Converter={StaticResource StringsAreEqualToTrue}, ConverterParameter=''}" Value="True" />
                        <Condition Binding="{Binding IconIndex, Converter={StaticResource StringsAreEqualToTrue}, ConverterParameter=''}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="OpacityMask" Value="{x:Null}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding SubIcon, Converter={StaticResource StringsAreEqualToTrue}, ConverterParameter=''}" Value="True" />
                        <Condition Binding="{Binding IconIndex, Converter={StaticResource StringsAreEqualToTrue}, ConverterParameter=''}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <VisualBrush>
                                <VisualBrush.Visual>
                                    <Canvas>
                                        <Path
                                            Data="M 0 15 L 3 15 A 12 12 0 0 0 15 3 L 15 0 L 36 0 L 36 36 L 0 36 Z"
                                            Fill="Black"
                                            Stretch="Uniform" />
                                    </Canvas>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Setter.Value>
                    </Setter>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding SubIcon, Converter={StaticResource StringsAreEqualToTrue}, ConverterParameter=''}" Value="False" />
                        <Condition Binding="{Binding IconIndex, Converter={StaticResource StringsAreEqualToTrue}, ConverterParameter=''}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <VisualBrush>
                                <VisualBrush.Visual>
                                    <Canvas>
                                        <Path
                                            Data="M 36 19 L 33 19 A 14 14 180 0 0 19 33 L 19 36 L 0 36 L 0 0 L 36 0 Z"
                                            Fill="Black"
                                            Stretch="Uniform" />
                                    </Canvas>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Setter.Value>
                    </Setter>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding SubIcon, Converter={StaticResource StringsAreEqualToTrue}, ConverterParameter=''}" Value="False" />
                        <Condition Binding="{Binding IconIndex, Converter={StaticResource StringsAreEqualToTrue}, ConverterParameter=''}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <VisualBrush>
                                <VisualBrush.Visual>
                                    <Canvas>
                                        <Path
                                            Data="M 0 15 L 3 15 A 12 12 0 0 0 15 3 L 15 0 L 36 0 L 36 19 L 33 19 A 14 14 180 0 0 19 33 L 19 36 L 0 36 Z"
                                            Fill="Black"
                                            Stretch="Uniform" />
                                    </Canvas>
                                </VisualBrush.Visual>
                            </VisualBrush>
                        </Setter.Value>
                    </Setter>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>
    <Grid>
        <DockPanel Background="Transparent" MouseDown="Grid_MouseDown">
            <DockPanel DockPanel.Dock="Top">

                <DockPanel
                    Margin="5,0"
                    Background="Transparent"
                    DockPanel.Dock="Left">
                    <WrapPanel
                        Margin="0,5,0,0"
                        Background="Transparent"
                        DockPanel.Dock="Bottom">
                        <Button
                            MinWidth="90"
                            Margin="0,0,2.5,0"
                            Click="Button_Click"
                            Content="SVG Editor"
                            Focusable="False"
                            IsTabStop="False"
                            Style="{DynamicResource {x:Static vsfx:VsResourceKeys.ButtonStyleKey}}"
                            ToolTip="Open the online GitLabs SVG editor in your browser" />
                        <Button
                            MinWidth="90"
                            Margin="2.5,0,2.5,0"
                            Click="Open_Material_Icon_Website"
                            Content="Material Icons"
                            Focusable="False"
                            IsTabStop="False"
                            Style="{DynamicResource {x:Static vsfx:VsResourceKeys.ButtonStyleKey}}"
                            ToolTip="Open the Material Icons site in your browser" />
                        <Button
                            MinWidth="90"
                            Margin="2.5,0,0,0"
                            Click="Open_RandomOrg_Website"
                            Content="Random.org"
                            Focusable="False"
                            IsTabStop="False"
                            Style="{DynamicResource {x:Static vsfx:VsResourceKeys.ButtonStyleKey}}"
                            ToolTip="Get a 32-digit randomized string" />
                    </WrapPanel>
                    <Grid Background="Transparent" DockPanel.Dock="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="SearchBox"
                            Margin="0"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            AcceptsReturn="False"
                            AcceptsTab="False"
                            FontSize="16"
                            GotFocus="SearchBox_GotFocus"
                            LostFocus="SearchBox_LostFocus"
                            Style="{DynamicResource {x:Static vsfx:VsResourceKeys.TextBoxStyleKey}}"
                            TextAlignment="Left"
                            TextChanged="SearchBox_TextChanged" />

                        <TextBlock
                            x:Name="PlaceHolderText"
                            Margin="5,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{DynamicResource {x:Static vsfx:VsBrushes.GrayTextKey}}"
                            IsHitTestVisible="False"
                            Text="Search ..." />

                        <Button
                            Grid.Column="1"
                            Background="{DynamicResource {x:Static vsfx:VsBrushes.ButtonFaceKey}}"
                            BorderBrush="{DynamicResource {x:Static vsfx:VsBrushes.StartPageButtonBorderKey}}"
                            Click="Open_RandomOrg_Website"
                            FocusVisualStyle="{x:Null}"
                            Focusable="False"
                            IsTabStop="False"
                            ToolTip="Clear">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Background" Value="{DynamicResource {x:Static vsfx:VsBrushes.ButtonFaceKey}}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsfx:VsBrushes.StartPageButtonBorderKey}}" />

                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">

                                            <Setter Property="Background" Value="{DynamicResource {x:Static vsfx:VsBrushes.ButtonFaceKey}}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsfx:VsBrushes.NewProjectProviderHoverBeginKey}}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource {x:Static vsfx:VsBrushes.ButtonFaceKey}}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsfx:VsBrushes.ToolWindowButtonDownActiveGlyphKey}}" />
                                        </Trigger>

                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path
                                Data="M19,3H16.3H7.7H5A2,2 0 0,0 3,5V7.7V16.4V19A2,2 0 0,0 5,21H7.7H16.4H19A2,2 0 0,0 21,19V16.3V7.7V5A2,2 0 0,0 19,3M15.6,17L12,13.4L8.4,17L7,15.6L10.6,12L7,8.4L8.4,7L12,10.6L15.6,7L17,8.4L13.4,12L17,15.6L15.6,17Z"
                                Fill="{DynamicResource {x:Static vsfx:VsBrushes.HelpSearchTextKey}}"
                                Stretch="Uniform" />
                        </Button>
                    </Grid>
                </DockPanel>

                <Grid
                    Width="50"
                    Height="50"
                    DockPanel.Dock="Right">
                    <Viewbox>
                        <Grid
                            Width="36"
                            Height="36"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="14" />
                            </Grid.RowDefinitions>
                            <Border
                                Name="mainIconBorder"
                                Grid.RowSpan="3"
                                Grid.ColumnSpan="3"
                                Width="36"
                                Height="36"
                                Style="{DynamicResource CompoundIconBorderStyle}">
                                <Grid>
                                    <Path
                                        Margin="6"
                                        Data="{Binding Icon}"
                                        Style="{DynamicResource MarkerBrushPathStyle}" />

                                </Grid>
                            </Border>
                            <Border
                                Name="iconIndexBorder"
                                Grid.Row="0"
                                Grid.Column="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                Visibility="{Binding IconIndex, Converter={StaticResource NotNullToVisible}}">
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                                    <TextBlock
                                        Margin="1"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Text="{Binding IconIndex}" />
                                </Viewbox>
                            </Border>
                            <Grid Grid.Row="2" Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5*" />
                                    <ColumnDefinition Width="90*" />
                                    <ColumnDefinition Width="5*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="5*" />
                                    <RowDefinition Height="90*" />
                                    <RowDefinition Height="5*" />
                                </Grid.RowDefinitions>
                                <Border
                                    Name="subIconBorder"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    Visibility="{Binding SubIcon, Converter={StaticResource NotNullToVisible}}">
                                    <Path Data="{Binding SubIcon}" Style="{DynamicResource MarkerBrushPathStyle}" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Viewbox>
                </Grid>
            </DockPanel>

            <virt:VirtualizingItemsControl
                x:Name="IconList"
                Background="Transparent"
                IsTabStop="False">
                <virt:VirtualizingItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <virt:VirtualizingWrapPanel Margin="3" IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </virt:VirtualizingItemsControl.ItemsPanel>
                <virt:VirtualizingItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Background="{DynamicResource {x:Static vsfx:VsBrushes.ButtonFaceKey}}"
                            BorderBrush="{DynamicResource {x:Static vsfx:VsBrushes.StartPageButtonBorderKey}}"
                            BorderThickness="1"
                            Click="Copy_Icon_Name"
                            FocusVisualStyle="{x:Null}"
                            Focusable="False"
                            Foreground="Transparent"
                            IsTabStop="False">
                            <Button.ToolTip>
                                <TextBlock>
                                    <Run Text="{Binding Key, Mode=OneWay}" />
                                    <LineBreak />
                                    <Run
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource {x:Static vsfx:VsBrushes.HelpSearchTextKey}}"
                                        Text="[Shift + Click]" />
                                    <Run Text=" to copy Path Data" />
                                </TextBlock>
                            </Button.ToolTip>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Panel.ZIndex" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Background" Value="{DynamicResource {x:Static vsfx:VsBrushes.ButtonFaceKey}}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsfx:VsBrushes.StartPageButtonBorderKey}}" />
                                    <Setter Property="Width" Value="52" />
                                    <Setter Property="Height" Value="52" />
                                    <Setter Property="Padding" Value="5" />
                                    <Setter Property="Margin" Value="3" />
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ThicknessAnimation
                                                            Storyboard.TargetProperty="Padding"
                                                            To="1"
                                                            Duration="0:0:0.01">
                                                            <ThicknessAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut" />
                                                            </ThicknessAnimation.EasingFunction>
                                                        </ThicknessAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <ThicknessAnimation
                                                            Storyboard.TargetProperty="Padding"
                                                            To="5"
                                                            Duration="0:0:0.75">
                                                            <ThicknessAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut" />
                                                            </ThicknessAnimation.EasingFunction>
                                                        </ThicknessAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                            <Setter Property="Background" Value="{DynamicResource {x:Static vsfx:VsBrushes.ButtonFaceKey}}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsfx:VsBrushes.NewProjectProviderHoverBeginKey}}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource {x:Static vsfx:VsBrushes.ButtonFaceKey}}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsfx:VsBrushes.ToolWindowButtonDownActiveGlyphKey}}" />
                                        </Trigger>

                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path
                                HorizontalAlignment="Center"
                                Data="{Binding PathData}"
                                Fill="{DynamicResource {x:Static vsfx:VsBrushes.ControlLinkTextPressedKey}}"
                                IsHitTestVisible="False"
                                Stretch="Uniform" />
                        </Button>
                    </DataTemplate>
                </virt:VirtualizingItemsControl.ItemTemplate>
            </virt:VirtualizingItemsControl>
        </DockPanel>
    </Grid>
</UserControl>
