<UserControl
    x:Class="Viper.IconBrowser.IconBrowserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Viper.IconBrowser"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:virt="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    xmlns:vsfx="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
    Name="IconBrowser"
    Background="{DynamicResource {x:Static vsshell:VsBrushes.WindowKey}}"
    Foreground="{DynamicResource {x:Static vsshell:VsBrushes.WindowTextKey}}">
    <UserControl.Resources>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource {x:Static vsfx:VsBrushes.ScreenTipBackgroundKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static vsfx:VsBrushes.ScreenTipTextKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsfx:VsBrushes.ScreenTipBorderKey}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="True" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <DockPanel Background="Transparent" MouseDown="Grid_MouseDown">
            <DockPanel
                Margin="15,5"
                Background="Transparent"
                DockPanel.Dock="Top">
                <Grid
                    Margin="0,5,0,0"
                    Background="Transparent"
                    DockPanel.Dock="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button
                        Margin="0,0,5,0"
                        Click="Button_Click"
                        Content="SVG Editor"
                        Focusable="False"
                        IsTabStop="False"
                        Style="{DynamicResource {x:Static vsfx:VsResourceKeys.ButtonStyleKey}}"
                        ToolTip="Open the online GitLabs SVG editor in your browser" />
                    <Button
                        Grid.Column="1"
                        Click="Open_Material_Icon_Website"
                        Content="Material Icons"
                        Focusable="False"
                        IsTabStop="False"
                        Style="{DynamicResource {x:Static vsfx:VsResourceKeys.ButtonStyleKey}}"
                        ToolTip="Open the Material Icons site in your browser" />
                </Grid>
                <Grid Background="Transparent" DockPanel.Dock="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="SearchBox"
                        Margin="0"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        AcceptsReturn="False"
                        AcceptsTab="False"
                        FontSize="16"
                        GotFocus="SearchBox_GotFocus"
                        LostFocus="SearchBox_LostFocus"
                        Style="{DynamicResource {x:Static vsfx:VsResourceKeys.TextBoxStyleKey}}"
                        TextAlignment="Left"
                        TextChanged="SearchBox_TextChanged" />

                    <TextBlock
                        x:Name="PlaceHolderText"
                        Margin="5,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{DynamicResource {x:Static vsfx:VsBrushes.GrayTextKey}}"
                        IsHitTestVisible="False"
                        Text="Search ..." />

                    <Button
                        Grid.Column="1"
                        Background="{DynamicResource {x:Static vsfx:VsBrushes.ButtonFaceKey}}"
                        BorderBrush="{DynamicResource {x:Static vsfx:VsBrushes.StartPageButtonBorderKey}}"
                        Click="Button_Click_1"
                        FocusVisualStyle="{x:Null}"
                        Focusable="False"
                        IsTabStop="False"
                        ToolTip="Clear">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Background" Value="{DynamicResource {x:Static vsfx:VsBrushes.ButtonFaceKey}}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsfx:VsBrushes.StartPageButtonBorderKey}}" />

                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">

                                        <Setter Property="Background" Value="{DynamicResource {x:Static vsfx:VsBrushes.ButtonFaceKey}}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsfx:VsBrushes.NewProjectProviderHoverBeginKey}}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static vsfx:VsBrushes.ButtonFaceKey}}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsfx:VsBrushes.ToolWindowButtonDownActiveGlyphKey}}" />
                                    </Trigger>

                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path
                            Data="M19,3H16.3H7.7H5A2,2 0 0,0 3,5V7.7V16.4V19A2,2 0 0,0 5,21H7.7H16.4H19A2,2 0 0,0 21,19V16.3V7.7V5A2,2 0 0,0 19,3M15.6,17L12,13.4L8.4,17L7,15.6L10.6,12L7,8.4L8.4,7L12,10.6L15.6,7L17,8.4L13.4,12L17,15.6L15.6,17Z"
                            Fill="{DynamicResource {x:Static vsfx:VsBrushes.HelpSearchTextKey}}"
                            Stretch="Uniform" />
                    </Button>
                </Grid>
            </DockPanel>

            <virt:VirtualizingItemsControl
                x:Name="IconList"
                Background="Transparent"
                IsTabStop="False">
                <virt:VirtualizingItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <virt:VirtualizingWrapPanel Margin="3" IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </virt:VirtualizingItemsControl.ItemsPanel>
                <virt:VirtualizingItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Background="{DynamicResource {x:Static vsfx:VsBrushes.ButtonFaceKey}}"
                            BorderBrush="{DynamicResource {x:Static vsfx:VsBrushes.StartPageButtonBorderKey}}"
                            BorderThickness="1"
                            Click="Copy_Icon_Name"
                            FocusVisualStyle="{x:Null}"
                            Focusable="False"
                            Foreground="Transparent"
                            IsTabStop="False">
                            <Button.ToolTip>
                                <TextBlock>
                                    <Run Text="{Binding Key, Mode=OneWay}" />
                                    <LineBreak />
                                    <Run
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource {x:Static vsfx:VsBrushes.HelpSearchTextKey}}"
                                        Text="[Shift + Click]" />
                                    <Run Text=" to copy Path Data" />
                                </TextBlock>
                            </Button.ToolTip>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    Padding="{TemplateBinding Padding}"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="Panel.ZIndex" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Background" Value="{DynamicResource {x:Static vsfx:VsBrushes.ButtonFaceKey}}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsfx:VsBrushes.StartPageButtonBorderKey}}" />
                                    <Setter Property="Width" Value="52" />
                                    <Setter Property="Height" Value="52" />
                                    <Setter Property="Padding" Value="5" />
                                    <Setter Property="Margin" Value="3" />
                                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                    <Setter Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                            To="1.25"
                                                            Duration="0:0:0.01">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                            To="1.25"
                                                            Duration="0:0:0.01">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                            To="1"
                                                            Duration="0:0:0.75">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                        <DoubleAnimation
                                                            Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                            To="1"
                                                            Duration="0:0:0.75">
                                                            <DoubleAnimation.EasingFunction>
                                                                <SineEase EasingMode="EaseInOut" />
                                                            </DoubleAnimation.EasingFunction>
                                                        </DoubleAnimation>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                            <Setter Property="Background" Value="{DynamicResource {x:Static vsfx:VsBrushes.ButtonFaceKey}}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsfx:VsBrushes.NewProjectProviderHoverBeginKey}}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource {x:Static vsfx:VsBrushes.ButtonFaceKey}}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vsfx:VsBrushes.ToolWindowButtonDownActiveGlyphKey}}" />
                                        </Trigger>

                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Path
                                HorizontalAlignment="Center"
                                Data="{Binding PathData}"
                                Fill="{DynamicResource {x:Static vsfx:VsBrushes.ControlLinkTextPressedKey}}"
                                IsHitTestVisible="False"
                                Stretch="Uniform" />
                        </Button>
                    </DataTemplate>
                </virt:VirtualizingItemsControl.ItemTemplate>
            </virt:VirtualizingItemsControl>
        </DockPanel>
    </Grid>
</UserControl>
